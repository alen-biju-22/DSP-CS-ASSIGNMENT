<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Marine Radar Simulator</title>
<style>
:root{--bg:#eef3f4;--panel:#fff;--ink:#11303b;--muted:#587079;--line:#cbd9de;--accent:#0b6e8a;--warn:#d9531e;--plot:#e6f0f4;--ok:#1b8a5a;color-scheme:light dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1418;--panel:#122229;--ink:#dbe9ee;--muted:#8aa3ac;--line:#25414b;--accent:#4cc2e0;--warn:#ff8a5c;--plot:#0d1a20;--ok:#4ad69a}}
:root[data-theme="dark"]{--bg:#0b1418;--panel:#122229;--ink:#dbe9ee;--muted:#8aa3ac;--line:#25414b;--accent:#4cc2e0;--warn:#ff8a5c;--plot:#0d1a20;--ok:#4ad69a}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 "Segoe UI","Helvetica Neue",system-ui,sans-serif;font-variant-numeric:tabular-nums}
.wrap{max-width:1100px;margin:0 auto;padding:20px 16px 32px}
h1{font-size:26px;margin:0 0 4px;letter-spacing:-.01em}
.lead{margin:0 0 18px;color:var(--muted);max-width:68ch}
h2{font-size:16px;margin:0 0 10px}
.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,380px);gap:20px;align-items:start}
.stage{position:relative;width:min(100%,560px);aspect-ratio:1;margin:0 auto;border-radius:50%;overflow:hidden;background:#04100c;border:3px solid var(--line)}
.stage canvas{position:absolute;inset:0;width:100%;height:100%}
.cap{color:var(--muted);font-size:13px;text-align:center;margin:8px 0}
.banner{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:10px 12px;text-align:center;max-width:560px;margin:0 auto}
.banner.on{border-color:var(--warn);color:var(--warn);font-weight:600}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:14px}
.ctl{display:block;margin-bottom:8px;font-size:14px}
.ctl span{display:flex;justify-content:space-between}
.ctl output{color:var(--accent);font-weight:600}
input[type=range]{width:100%;accent-color:var(--accent)}
.row{display:flex;gap:8px;margin-top:6px}
button{flex:1;font:inherit;padding:8px 10px;border-radius:8px;border:1px solid var(--accent);background:transparent;color:var(--accent);cursor:pointer}
button:hover{background:var(--accent);color:var(--panel)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.readout{margin:8px 0 0;color:var(--muted);font-size:13px}
table{width:100%;border-collapse:collapse;font-size:13px;margin-top:6px}
th,td{text-align:left;padding:4px 4px;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-weight:500}
.alarm{color:var(--warn);font-weight:600}.lost{color:var(--muted)}.trk{color:var(--ok)}
.charts{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:8px}
figure{margin:0}
figcaption{font-size:14px;margin-bottom:6px;font-weight:600}
figure canvas{width:100%;height:230px;display:block;border:1px solid var(--line);border-radius:8px;background:var(--panel)}
@media (max-width:860px){.grid,.charts{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="wrap">
<h1>Marine radar simulator</h1>
<p class="lead">Control and DSP work as one loop. The PID loop sets how fast the antenna sweeps, and the CFAR detector decides which echoes reach the screen and the collision tracker. Change the sliders to see what each stage does.</p>
<div class="grid">
<section>
<div class="stage"><canvas id="ppi"></canvas><canvas id="ov"></canvas></div>
<p class="cap">Relative-motion display, rings every 2 nm. Time is compressed: 1 s is about 1 min.</p>
<div id="alarm" class="banner">No CPA alarms</div>
</section>
<aside>
<div class="panel"><h2>Signal processing (DSP)</h2><div id="dsp"></div>
<label class="ctl"><input type="checkbox" id="raw" checked> Show raw echo and sea clutter</label></div>
<div class="panel"><h2>Antenna speed control</h2><div id="ctl"></div>
<div class="row"><button id="gust">Apply wind gust</button><button id="pause">Pause</button></div>
<p id="rpm" class="readout"></p></div>
<div class="panel"><h2>Collision tracking (ARPA)</h2><div id="trk"></div>
<table><thead><tr><th>Contact</th><th>Range</th><th>CPA</th><th>TCPA</th><th>Status</th></tr></thead><tbody id="tb"></tbody></table></div>
</aside>
</div>
<div class="charts">
<figure><figcaption>Range profile of the latest beam (held 1.5 s after a detection)</figcaption><canvas id="prof"></canvas></figure>
<figure><figcaption>Antenna speed response (last 12 s)</figcaption><canvas id="pid"></canvas></figure>
</div>
</div>
<script>
const $=id=>document.getElementById(id);
const SL=[['alpha','CFAR threshold factor (α)',1.5,7,.1,3.6,'dsp'],['clutter','Sea-clutter level',.2,2.5,.1,1,'dsp'],
['sp','Speed setpoint (rpm)',12,48,1,24,'ctl'],['kp','Kp (proportional)',.5,15,.5,4,'ctl'],['ki','Ki (integral)',0,10,.5,3,'ctl'],['kd','Kd (derivative)',0,1,.05,.05,'ctl'],
['cpa','CPA alarm limit (nm)',.2,2,.1,.8,'trk']];
const P={};
SL.forEach(([id,lab,mn,mx,st,v,g])=>{P[id]=v;const l=document.createElement('label');l.className='ctl';
l.innerHTML=`<span>${lab}<output id="o_${id}">${v}</output></span><input type="range" min="${mn}" max="${mx}" step="${st}" value="${v}">`;
l.querySelector('input').oninput=e=>{P[id]=+e.target.value;$('o_'+id).textContent=P[id]};$(g).appendChild(l)});

const N=120,RMAX=6,DR=RMAX/N,TR=10,GD=2,rad=d=>d*Math.PI/180;
let simT=0,w=0,integ=0,prevErr=P.sp,gustLeft=0,ang=0,paused=false,hist=[];
let last=null,hold=null,holdUntil=0,lastTbl=0;
const wb=()=>Math.pow(-Math.log(1-Math.random()),1/1.6);
const L='ABCD';
function spawn(s,early){const a=rad(Math.random()*360),r=5.2+Math.random()*.6;
const x=r*Math.sin(a),y=r*Math.cos(a),q=Math.random()*1.6,qa=Math.random()*6.28;
const dx=q*Math.sin(qa)-x,dy=q*Math.cos(qa)-y,d=Math.hypot(dx,dy),sp=.15+Math.random()*.15;
s.x=x;s.y=y;s.vx=dx/d*sp;s.vy=dy/d*sp;s.lastDet=-99;
if(early){const k=Math.random()*12;s.x+=s.vx*k;s.y+=s.vy*k}geo(s)}
function geo(s){s.rng=Math.hypot(s.x,s.y);s.brg=(Math.atan2(s.x,s.y)*180/Math.PI+360)%360}
const ships=L.split('').map(n=>{const s={n};spawn(s,true);return s});

function cfar(e){const t=[],d=[];for(let i=0;i<N;i++){let s=0,c=0;
for(let k=GD+1;k<=GD+TR;k++){if(i-k>=0){s+=e[i-k];c++}if(i+k<N){s+=e[i+k];c++}}
t[i]=P.alpha*s/c;d[i]=e[i]>t[i]}return[t,d]}

const ppi=$('ppi'),ov=$('ov'),pc=ppi.getContext('2d'),oc=ov.getContext('2d');
let S=0,R=0,dpr=1;
function size(){dpr=window.devicePixelRatio||1;S=ppi.parentElement.clientWidth;R=S/2-4;
[ppi,ov].forEach(c=>{c.width=c.height=S*dpr});pc.setTransform(dpr,0,0,dpr,0,0);oc.setTransform(dpr,0,0,dpr,0,0);
pc.fillStyle='#04100c';pc.fillRect(0,0,S,S)}
window.addEventListener('resize',size);size();

function beam(deg){const e=[];
for(let i=0;i<N;i++)e[i]=(1.5+6*Math.exp(-i/105))*P.clutter*wb();
ships.forEach(s=>{const df=((deg-s.brg+540)%360)-180;
if(Math.abs(df)<1.6&&s.rng<RMAX){const b=Math.round(s.rng/DR-.5),pk=38*(1-Math.abs(df)/4);
e[b]+=pk;if(b>0)e[b-1]+=.55*pk;if(b<N-1)e[b+1]+=.65*pk}});
const[t,d]=cfar(e),sn=Math.sin(rad(deg)),cs=Math.cos(rad(deg)),raw=$('raw').checked;let any=false;
for(let i=0;i<N;i++){const r=(i+.5)*DR/RMAX*R,x=S/2+r*sn,y=S/2-r*cs;
if(d[i]){any=true;pc.fillStyle='#ffe98a';pc.fillRect(x-2.5,y-2.5,5,5);
ships.forEach(s=>{const df=((deg-s.brg+540)%360)-180;
if(Math.abs(df)<3&&Math.abs((i+.5)*DR-s.rng)<.25)s.lastDet=simT})}
else if(raw){pc.fillStyle=`rgba(70,230,140,${Math.min(.6,e[i]/18*.5)})`;pc.fillRect(x-1.2,y-1.2,2.4,2.4)}}
last={e,t,d};if(any){hold=last;holdUntil=performance.now()+1500}}

function step(dt){const n=Math.ceil(dt/.004),h=dt/n;
for(let k=0;k<n;k++){const err=P.sp-w,de=(err-prevErr)/h,u0=P.kp*err+P.ki*integ+P.kd*de,u=Math.max(-60,Math.min(60,u0));
if(u===u0)integ+=err*h;prevErr=err;
const dist=gustLeft>0?5:0;if(gustLeft>0)gustLeft-=h;
w+=h*(-.6*w+u-dist);simT+=h}
hist.push({t:simT,w,g:gustLeft>0});while(hist[0].t<simT-12)hist.shift();
ships.forEach(s=>{s.x+=s.vx*dt;s.y+=s.vy*dt;geo(s);if(s.rng>6.3||(s.rng>5.5&&s.x*s.vx+s.y*s.vy>0))spawn(s,false)});
const prev=ang;ang+=Math.max(0,w)*6*dt;
for(let k=Math.floor(prev)+1;k<=Math.floor(ang);k++)beam(k%360)}

function col(n){return getComputedStyle(document.documentElement).getPropertyValue(n).trim()}
function drawOv(){oc.clearRect(0,0,S,S);const c=S/2;
oc.strokeStyle='rgba(120,255,190,.28)';oc.lineWidth=1;oc.fillStyle='rgba(150,255,200,.6)';oc.font='11px sans-serif';
for(let k=1;k<=3;k++){oc.beginPath();oc.arc(c,c,R*k/3,0,6.283);oc.stroke();oc.fillText(k*2+' nm',c+4,c-R*k/3+12)}
oc.beginPath();oc.moveTo(c,c-R);oc.lineTo(c,c+R);oc.moveTo(c-R,c);oc.lineTo(c+R,c);oc.stroke();
oc.setLineDash([4,4]);oc.strokeStyle='rgba(255,170,90,.7)';oc.beginPath();oc.arc(c,c,R*P.cpa/RMAX,0,6.283);oc.stroke();oc.setLineDash([]);
const a=rad(ang%360-90);oc.fillStyle='rgba(120,255,190,.12)';oc.beginPath();oc.moveTo(c,c);oc.arc(c,c,R,a-.4,a);oc.closePath();oc.fill();
oc.strokeStyle='rgba(180,255,210,.95)';oc.lineWidth=1.5;oc.beginPath();oc.moveTo(c,c);oc.lineTo(c+R*Math.cos(a),c+R*Math.sin(a));oc.stroke();
oc.fillStyle='#8fffc0';oc.beginPath();oc.arc(c,c,3,0,6.283);oc.fill();
ships.forEach(s=>{const m=info(s);if(!m.tracked)return;const x=c+s.x/RMAX*R,y=c-s.y/RMAX*R;
oc.strokeStyle=m.alarm?'#ff6a4a':'#8fd8ff';oc.fillStyle=oc.strokeStyle;oc.lineWidth=1.5;
oc.beginPath();oc.arc(x,y,7,0,6.283);oc.stroke();
oc.beginPath();oc.moveTo(x,y);oc.lineTo(x+s.vx*8/RMAX*R,y-s.vy*8/RMAX*R);oc.stroke();oc.fillText(s.n,x+10,y-8)})}

function info(s){const tracked=simT-s.lastDet<60/Math.max(w,6)+1.5,v2=s.vx*s.vx+s.vy*s.vy;
const tc=-(s.x*s.vx+s.y*s.vy)/v2,cx=s.x+s.vx*tc,cy=s.y+s.vy*tc,cp=tc>0?Math.hypot(cx,cy):s.rng;
return{tracked,tc,cp,alarm:tracked&&tc>0&&tc<15&&cp<P.cpa}}

function table(){let al=null;
$('tb').innerHTML=ships.map(s=>{const m=info(s);if(m.alarm&&(!al||m.tc<al.tc))al={s,m};
return m.tracked?`<tr><td>${s.n}</td><td>${s.rng.toFixed(1)} nm</td><td>${m.tc>0?m.cp.toFixed(2)+' nm':'opening'}</td><td>${m.tc>0?m.tc.toFixed(1)+' min':'–'}</td><td class="${m.alarm?'alarm':'trk'}">${m.alarm?'Alarm':'Tracking'}</td></tr>`
:`<tr><td>${s.n}</td><td colspan="3" class="lost">no plot</td><td class="lost">Lost</td></tr>`}).join('');
const b=$('alarm');b.className='banner'+(al?' on':'');
b.textContent=al?`CPA alarm: contact ${al.s.n} passes ${al.m.cp.toFixed(2)} nm in ${al.m.tc.toFixed(1)} min`:'No CPA alarms';
$('rpm').textContent=`Antenna speed ${w.toFixed(1)} rpm, one sweep every ${(60/Math.max(w,.1)).toFixed(1)} s`}

function axes(cv,xmax,ymax,xt,yt,xl,yl){const d=window.devicePixelRatio||1,W=cv.clientWidth,H=cv.clientHeight;
if(cv.width!==Math.round(W*d)){cv.width=Math.round(W*d);cv.height=Math.round(H*d)}
const g=cv.getContext('2d');g.setTransform(d,0,0,d,0,0);g.clearRect(0,0,W,H);
const l=42,r=10,t=10,b=32,X=v=>l+v/xmax*(W-l-r),Y=v=>H-b-v/ymax*(H-t-b);
g.fillStyle=col('--plot');g.fillRect(l,t,W-l-r,H-t-b);g.font='11px sans-serif';g.fillStyle=col('--muted');g.strokeStyle=col('--line');g.lineWidth=1;
yt.forEach(v=>{g.beginPath();g.moveTo(l,Y(v));g.lineTo(W-r,Y(v));g.stroke();g.textAlign='right';g.fillText(v,l-5,Y(v)+4)});
g.textAlign='center';xt.forEach(v=>g.fillText(v,X(v),H-b+14));
g.fillText(xl,l+(W-l-r)/2,H-5);g.save();g.translate(11,t+(H-t-b)/2);g.rotate(-Math.PI/2);g.fillText(yl,0,0);g.restore();
return{g,X,Y,l,r,t,b,W,H}}

function drawProf(){const p=performance.now()<holdUntil?hold:last;
const A=axes($('prof'),RMAX,50,[0,2,4,6],[0,10,20,30,40,50],'Range (nm)','Echo amplitude');if(!p)return;const{g,X,Y}=A;
g.lineWidth=1.3;g.strokeStyle=col('--accent');g.beginPath();p.e.forEach((v,i)=>{const x=X((i+.5)*DR),y=Y(Math.min(v,50));i?g.lineTo(x,y):g.moveTo(x,y)});g.stroke();
g.setLineDash([5,4]);g.lineWidth=2;g.strokeStyle=col('--warn');g.beginPath();p.t.forEach((v,i)=>{const x=X((i+.5)*DR),y=Y(Math.min(v,50));i?g.lineTo(x,y):g.moveTo(x,y)});g.stroke();g.setLineDash([]);
g.fillStyle=col('--ink');p.d.forEach((f,i)=>{if(f){g.beginPath();g.arc(X((i+.5)*DR),Y(Math.min(p.e[i],50)),3.5,0,6.283);g.fill()}})}

function drawPid(){const mx=Math.max(30,Math.ceil(Math.max(P.sp*1.3,...hist.map(h=>h.w))/10)*10),t0=simT-12;
const A=axes($('pid'),12,mx,[0,2,4,6,8,10,12],[0,mx/3,2*mx/3,mx].map(Math.round),'Time (s, last 12 s)','Rotation speed (rpm)');const{g,X,Y,t,H,b}=A;
g.fillStyle='rgba(120,150,165,.3)';let s0=null;hist.forEach((h,i)=>{if(h.g&&s0===null)s0=h.t;if((!h.g||i===hist.length-1)&&s0!==null){g.fillRect(X(s0-t0),t,X(h.t-t0)-X(s0-t0),H-t-b);s0=null}});
g.setLineDash([5,4]);g.strokeStyle=col('--warn');g.lineWidth=1.8;g.beginPath();g.moveTo(X(0),Y(P.sp));g.lineTo(X(12),Y(P.sp));g.stroke();g.setLineDash([]);
g.strokeStyle=col('--accent');g.lineWidth=2.4;g.beginPath();hist.forEach((h,i)=>{const x=X(h.t-t0),y=Y(Math.max(0,Math.min(h.w,mx)));i?g.lineTo(x,y):g.moveTo(x,y)});g.stroke();
g.font='11px sans-serif';g.textAlign='left';g.fillStyle=col('--warn');g.fillText('Setpoint '+P.sp+' rpm',X(.2),Y(P.sp)-5)}

$('gust').onclick=()=>{gustLeft=1};
$('pause').onclick=e=>{paused=!paused;e.target.textContent=paused?'Resume':'Pause'};
function frame(now){const dt=Math.min((now-(last2||now))/1000,.05);last2=now;
if(!paused){step(dt);pc.fillStyle='rgba(4,16,12,.025)';pc.fillRect(0,0,S,S)}
drawOv();drawProf();drawPid();if(now-lastTbl>250){table();lastTbl=now}requestAnimationFrame(frame)}
let last2=null;requestAnimationFrame(frame);
</script>
</body>
</html>
